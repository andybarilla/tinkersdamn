---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import defaultOgImage from '../assets/og-home.jpg';

const {
  title = "Tinker's Damn",
  description = "Tinker's Damn plays alternative rock covers in Colorado Springs and original grunge, stoner, and psych rock across the Front Range.",
  ogImage = defaultOgImage,
  ogImageAlt = "Tinker's Damn, alternative rock covers and original music from Colorado Springs",
  theme = 'default',
} = Astro.props;

const pageTitle = title === "Tinker's Damn" ? title : `${title} | Tinker's Damn`;
const ogImageUrl = new URL(ogImage.src, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700;800&family=Oswald:wght@500;600;700&family=Permanent+Marker&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <ClientRouter />
</head>
<body class={`theme-${theme}`}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>
