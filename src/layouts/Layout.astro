---
import '../styles/global.css';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from 'astro:transitions';
import ogImage from '../assets/bandphoto2022adjusted2.jpg';

const {
    title = "Tinker's Damn",
    description = "Original grunge, stoner, and psychedelic rock from Colorado Springs.",
} = Astro.props;

const pageTitle = title === "Tinker's Damn" ? title : `${title} — Tinker's Damn`;
const ogImageUrl = new URL(ogImage.src, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <title>{pageTitle}</title>
    <meta name="description" content={description}/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content={ogImageUrl}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={pageTitle}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImageUrl}/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&family=Oswald:wght@500;600;700&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>
<Header/>
<main>
    <slot/>
</main>
<Footer/>
</body>
</html>
