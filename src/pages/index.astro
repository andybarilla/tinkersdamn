---
import '../styles/global.css';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {getCollection} from 'astro:content';
import Post from "../components/Post.astro";
import Hero from "../components/Hero.astro";
import PromoHero from "../components/PromoHero.astro";
import { ClientRouter } from 'astro:transitions';
import ogImage from '../assets/bandphoto2022adjusted2.jpg';

const allPosts = (await getCollection('blog'))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const description = "Original grunge, stoner, and psychedelic rock from Colorado Springs. New album From the Depths of Earl Drive out now.";
const ogImageUrl = new URL(ogImage.src, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Tinker's Damn — Grunge & Stoner Rock from Colorado Springs</title>
    <meta name="description" content={description}/>
    <meta property="og:title" content="Tinker's Damn"/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content={ogImageUrl}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="Tinker's Damn"/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImageUrl}/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow:wght@400;500;600;700&family=Oswald:wght@500;600;700&family=Spline+Sans+Mono:wght@400;500&display=swap" rel="stylesheet">
    <ClientRouter />
</head>
<body>

<PromoHero/>
<Hero/>

<div id="navigation-start">
    <Header showLogo={false}/>
</div>

<main>
    <section class="panel panel-dark">
        <div class="wrap">
            <div class="sec-label">
                <span class="label">Latest</span>
                <span class="line"></span>
            </div>
            {allPosts.map((post, index) => (
                <div style={`animation-delay: ${index * 0.1}s`}>
                    <Post id={post.id} key={index}/>
                </div>
            ))}
        </div>
    </section>
</main>

<Footer/>

</body>
</html>
