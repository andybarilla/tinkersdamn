---
import Layout from "../layouts/Layout.astro";
import Panel from "../components/Panel.astro";
---
<Layout title="Music" description="Listen to From the Depths of Earl Drive, the debut album from Tinker's Damn.">
    <Panel tone="dark">
        <div class="sec-label"><span class="label">The Record</span><span class="line"></span></div>
        <h1>From The Depths Of Earl Drive</h1>
        <iframe
            class="album-embed"
            style="border: 0; height: 638px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=3699694381/size=large/bgcol=14110f/linkcol=e0a32e/tracklist=true/transparent=true/"
            seamless title="From the Depths of Earl Drive">
            <a href="https://tinkersdamn.bandcamp.com/album/from-the-depths-of-earl-drive">From the Depths of Earl Drive by Tinker's Damn</a>
        </iframe>
    </Panel>
</Layout>

<style>
    .album-embed { width: 100%; max-width: 28rem; margin-top: 1.25rem; display: block; }
</style>
