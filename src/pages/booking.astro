---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Booking"
  description="Book Tinker's Damn for alternative rock covers in Colorado Springs or original grunge, stoner, and psych rock across the Front Range."
  theme="default"
>
  <section class="booking-page page-section">
    <div class="page-wrap">
      <p class="section-kicker">Booking</p>
      <h1>Which band are you looking for?</h1>
      <p class="intro">Same four people, two different kinds of night. Pick the useful press kit below, or email us directly if you already know what you need.</p>
      <div class="booking-grid">
        <article class="cover-choice">
          <span>Colorado Springs</span>
          <h2>Alternative rock covers</h2>
          <p>80s, 90s, and 2000s alternative rock. Flexible formats from 45 minutes through three one-hour sets.</p>
          <a class="btn btn-cover" href="/covers">Cover booking EPK</a>
        </article>
        <article class="original-choice">
          <span>Colorado Front Range</span>
          <h2>Original rock</h2>
          <p>A 45-minute grunge, stoner, and psych set, with the album, videos, press photo, and stage details.</p>
          <a class="btn btn-primary" href="/originals">Original music EPK</a>
        </article>
      </div>
      <div class="direct-contact">
        <p class="section-kicker">Direct contact</p>
        <a href="mailto:band@tinkersdamnband.com">band@tinkersdamnband.com</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .booking-page { min-height: 65vh; background: #171411; }
  .booking-page h1 { max-width: 15ch; font-size: clamp(3rem, 7vw, 6rem); }
  .intro { max-width: 60ch; margin: 1rem 0 2rem; color: var(--color-bone-dim); font-size: 1.15rem; }
  .booking-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .booking-grid article { min-height: 22rem; padding: clamp(1.5rem, 4vw, 2.5rem); border: 3px solid; display: flex; flex-direction: column; align-items: flex-start; }
  .booking-grid span { font: 700 .75rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .booking-grid h2 { margin: .8rem 0; font-size: clamp(2.2rem, 5vw, 4rem); }
  .booking-grid p { max-width: 48ch; margin-bottom: 1.5rem; }
  .booking-grid .btn { margin-top: auto; }
  .cover-choice { background: #f5ecd9; color: #241d17; border-color: var(--cover-pink) !important; box-shadow: 9px 9px 0 var(--cover-pink); }
  .cover-choice h2 { color: #241d17; }
  .cover-choice span { color: #8f1d4b; }
  .original-choice { background: #0d0b0a; color: var(--color-bone-dim); border-color: #5f3f15 !important; box-shadow: 9px 9px 0 #050404; }
  .original-choice span { color: var(--color-amber); }
  .direct-contact { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid rgba(236,228,211,.18); }
  .direct-contact a { font-size: clamp(1.2rem, 4vw, 2rem); font-family: var(--font-mono); }
  @media (max-width: 720px) { .booking-grid { grid-template-columns: 1fr; } }
</style>
