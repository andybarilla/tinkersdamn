---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import { Image } from 'astro:assets';
import bandPhoto from '../assets/bandphoto2022adjusted2.jpg';
import { YouTube } from 'astro-embed';
---
<Layout
    title="Booking & Press"
    description="Book Tinker's Damn — original grunge/stoner/psych rock from Colorado Springs. Bio, music, live video, press photo, and tech info.">

    <Panel tone="dark">
        <div class="sec-label"><span class="label">Booking & Press</span><span class="line"></span></div>
        <h1>Book The Band</h1>
        <p class="lead">Original grunge / stoner / psych rock from Colorado Springs — a cross between Clutch and The Pretty Reckless. Booking shows across the Front Range.</p>
        <div class="cta">
            <a class="btn btn-primary" href="mailto:band@tinkersdamnband.com">Book Us</a>
            <a class="btn btn-ghost" href="https://tinkersdamn.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen</a>
        </div>
        <div class="media">
            <iframe class="album-embed" style="border:0;height:470px;"
                src="https://bandcamp.com/EmbeddedPlayer/album=3699694381/size=large/bgcol=ffffff/linkcol=0687f5/transparent=true/tracklist=true/tracks=2831569808,2732741698,1869581835,2126876200/esig=66edf736dfa944252a71f7c8ac792166/"
                seamless title="From the Depths of Earl Drive">
                <a href="https://tinkersdamn.bandcamp.com/album/from-the-depths-of-earl-drive">From the Depths of Earl Drive by Tinker's Damn</a>
            </iframe>
            <YouTube id="https://www.youtube.com/watch?v=uLJ_V1NMJbM" title="Tinker's Damn: Safe (The Scrote Song) [Live]" class="live-vid"/>
        </div>
    </Panel>

    <Panel tone="paper" divider="down">
        <div class="sec-label"><span class="label">The Band</span><span class="line"></span></div>
        <h2 class="misreg">Four-Piece, Full Electric</h2>
        <div class="band-grid">
            <div>
                <p>Courtney (vocals, keys), Shawn (guitar), Andy (bass), and Rob (drums) have rocked Colorado Springs since 2014 — a cover band that turned all-original in 2023. Debut album <em>From the Depths of Earl Drive</em> out now.</p>
                <p>Live, we play a 45-minute original set: full electric, multi-vocal, loud.</p>
                <p><a href={bandPhoto.src} download="tinkers-damn.jpg">Download press photo &rarr;</a></p>
            </div>
            <div class="press-photo"><Image src={bandPhoto} alt="Tinker's Damn band photo"/></div>
        </div>
    </Panel>

    <Panel tone="dark" divider="up">
        <div class="sec-label"><span class="label">Tech</span><span class="line"></span></div>
        <h2>Stage & Input List</h2>
        <ol class="inputs">
            <li>Kick — mic</li>
            <li>Bass — DI</li>
            <li>Guitar — mic'd cab</li>
            <li>Keys — DI <span class="warn">(requires +48V phantom power)</span></li>
            <li>Vocals — Courtney (lead)</li>
            <li>Vocals — Andy</li>
            <li>Vocals — Rob</li>
        </ol>
        <p>Courtney runs in-ears; three wedge mixes for the rest. We bring our own backline. Full stage plot available on request.</p>
        <div class="contact">
            <span class="label">Contact</span>
            <p>
                Booking: <a href="mailto:band@tinkersdamnband.com">band@tinkersdamnband.com</a><br>
                <a href="https://tinkersdamn.bandcamp.com" target="_blank" rel="noopener noreferrer">Bandcamp</a> ·
                <a href="https://bsky.app/profile/tinkersdamnband.com" target="_blank" rel="noopener noreferrer">Bluesky</a> ·
                <a href="/videos">More video</a>
            </p>
        </div>
    </Panel>
</Layout>

<style>
    .lead { max-width: 60ch; font-size: 1.15rem; margin-top: 0.5rem; }
    .cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin: 1.5rem 0; }
    .media { display: grid; grid-template-columns: minmax(0, 24rem) 1fr; gap: 1.5rem; align-items: start; margin-top: 1rem; }
    .album-embed { width: 100%; display: block; }
    .live-vid { width: 100%; }
    .band-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.25rem; align-items: center; margin-top: 1rem; }
    .band-grid p { margin-bottom: 0.9rem; }
    .press-photo { justify-self: center; transform: rotate(-1.5deg); }
    .press-photo :global(img) { border: 8px solid #fff; box-shadow: 8px 10px 0 rgba(20, 17, 15, 0.22); display: block; }
    .inputs { list-style: decimal; padding-left: 1.4rem; margin: 1rem 0; line-height: 1.9; }
    .inputs .warn { color: var(--color-road); font-weight: 600; }
    .contact { margin-top: 1.75rem; }
    @media (max-width: 820px) { .media, .band-grid { grid-template-columns: 1fr; } .press-photo { justify-self: start; } }
</style>
