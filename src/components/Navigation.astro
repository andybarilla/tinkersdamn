---
import Guitar from './icons/Guitar.astro';
import Calendar from './icons/Calendar.astro';
import MusicNote from './icons/MusicNote.astro';
import Video from './icons/Video.astro';
import Mail from './icons/Mail.astro';
import Info from './icons/Info.astro';
import Bluesky from './icons/Bluesky.astro';
import Bandcamp from "./icons/Bandcamp.astro";
---

<nav class="nav-bar w-full sticky top-0 z-50">
    <div class="px-3 w-full">
        <div class="flex items-center justify-between">
            <div class="hidden md:flex">
                <a href="/#navigation-start" class="nav-link"><Guitar class="w-5 h-5" /><span>Home</span></a>
                <a href="/shows" class="nav-link"><Calendar class="w-5 h-5" /><span>Shows</span></a>
                <a href="/music" class="nav-link"><MusicNote class="w-5 h-5" /><span>Music</span></a>
                <a href="/videos" class="nav-link"><Video class="w-5 h-5" /><span>Videos</span></a>
                <a href="/booking" class="nav-link"><Mail class="w-5 h-5" /><span>Booking</span></a>
                <a href="/about" class="nav-link"><Info class="w-5 h-5" /><span>About</span></a>
            </div>
            <div class="hidden md:flex w-full justify-end items-center">
                <a href="https://tinkersdamn.bandcamp.com" target="_blank" rel="noopener noreferrer" class="social-link bandcamp" aria-label="Bandcamp"><Bandcamp class="w-5 h-5" /></a>
                <a href="https://bsky.app/profile/tinkersdamnband.com" target="_blank" rel="noopener noreferrer" class="social-link bluesky" aria-label="Bluesky"><Bluesky class="w-5 h-5" /></a>
            </div>
            <div class="md:hidden">
                <button id="nav-toggle" class="text-bone focus:outline-none" aria-label="Toggle menu">
                    <svg class="h-6 w-6 mt-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</nav>
<div id="mobile-menu" class="mobile-menu hidden md:hidden w-full sticky top-[44px] z-40">
    <a href="/" class="m-link">Home</a>
    <a href="/shows" class="m-link">Shows</a>
    <a href="/music" class="m-link">Music</a>
    <a href="/videos" class="m-link">Videos</a>
    <a href="/booking" class="m-link">Booking</a>
    <a href="/about" class="m-link">About</a>
</div>

<style>
    .nav-bar {
        background: rgba(20, 17, 15, 0.92);
        backdrop-filter: blur(8px) saturate(140%);
        border-bottom: 2px solid var(--color-rust);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
    }
    .nav-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-condensed);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.92rem;
        color: var(--color-bone-dim);
        text-decoration: none;
        padding: 0.55rem 0.85rem;
        transition: color 0.18s ease, background 0.18s ease;
    }
    .nav-link:hover { color: var(--color-char); background: var(--color-road); }

    .social-link {
        color: var(--color-bone-dim);
        padding: 0.5rem;
        display: flex;
        align-items: center;
        transition: color 0.18s ease;
    }
    .social-link.bandcamp:hover { color: #61929C; }
    .social-link.bluesky:hover { color: #1185fe; }

    .mobile-menu {
        background: rgba(20, 17, 15, 0.96);
        backdrop-filter: blur(8px);
        border-bottom: 2px solid var(--color-rust);
    }
    .m-link {
        display: block;
        font-family: var(--font-condensed);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-bone);
        text-decoration: none;
        text-align: center;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid rgba(196, 32, 42, 0.2);
        transition: background 0.18s ease, color 0.18s ease;
    }
    .m-link:hover { background: var(--color-road); color: var(--color-char); }
</style>
<script>
    const navToggle = document.getElementById('nav-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    navToggle?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));
</script>
