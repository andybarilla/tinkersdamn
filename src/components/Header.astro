---
import Navigation from './Navigation.astro';
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/" aria-label="Tinker's Damn home">
      <span>Tinker's</span> <b>Damn</b>
    </a>
    <Navigation />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(20, 17, 15, 0.94);
    border-bottom: 3px solid var(--page-accent, var(--color-rust));
    backdrop-filter: blur(12px);
  }
  .header-inner {
    width: min(100% - 2rem, 74rem);
    min-height: 4.5rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .wordmark {
    flex: 0 0 auto;
    color: var(--color-bone);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .wordmark b { color: var(--page-accent, var(--color-road)); font-weight: inherit; }
  .wordmark:hover { color: var(--color-bone); }
  @media (max-width: 860px) { .header-inner { min-height: 4rem; } }
</style>
