---
import Bandcamp from './icons/Bandcamp.astro';
import Bluesky from './icons/Bluesky.astro';
import Instagram from './icons/Instagram.astro';
import Facebook from './icons/Facebook.astro';
import YouTube from './icons/YouTube.astro';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <div class="footer-name">Tinker's <span>Damn</span></div>
      <p>Alternative rock covers in Colorado Springs. Original grunge, stoner, and psych rock across the Front Range.</p>
      <a class="email" href="mailto:band@tinkersdamnband.com">band@tinkersdamnband.com</a>
    </div>
    <div class="footer-links" aria-label="Footer navigation">
      <a href="/covers">Cover EPK</a>
      <a href="/originals">Original EPK</a>
      <a href="/shows">Shows</a>
      <a href="/booking">Booking</a>
      <a href="/stageplot.pdf" download>Stage plot</a>
    </div>
    <div class="footer-socials">
      <a href="https://tinkersdamn.bandcamp.com" target="_blank" rel="noopener noreferrer" aria-label="Bandcamp"><Bandcamp class="w-5 h-5" /></a>
      <a href="https://bsky.app/profile/tinkersdamnband.com" target="_blank" rel="noopener noreferrer" aria-label="Bluesky"><Bluesky class="w-5 h-5" /></a>
      <a href="https://www.instagram.com/tinkersdamnband" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><Instagram class="w-5 h-5" /></a>
      <a href="https://www.facebook.com/tinkersdamnband" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><Facebook class="w-5 h-5" /></a>
      <a href="https://www.youtube.com/@tinkersdamn" target="_blank" rel="noopener noreferrer" aria-label="YouTube"><YouTube class="w-5 h-5" /></a>
    </div>
  </div>
  <div class="footer-base">© {new Date().getFullYear()} Tinker's Damn</div>
</footer>

<style>
  .site-footer { padding: 3rem 0 1.25rem; background: #0d0b0a; border-top: 3px solid var(--page-accent, var(--color-rust)); }
  .footer-inner { width: min(100% - 3rem, 70rem); margin: 0 auto; display: grid; grid-template-columns: 1.4fr .7fr auto; gap: 2.5rem; align-items: start; }
  .footer-name { font-family: var(--font-display); font-size: 1.75rem; text-transform: uppercase; }
  .footer-name span { color: var(--page-accent, var(--color-road)); }
  .footer-inner p { max-width: 48ch; margin: .4rem 0 .8rem; color: var(--color-bone-dim); font-size: .95rem; }
  .email { font-family: var(--font-mono); font-size: .82rem; }
  .footer-links { display: grid; gap: .45rem; }
  .footer-links a { color: var(--color-bone-dim); font-family: var(--font-condensed); text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
  .footer-links a:hover { color: var(--color-bone); }
  .footer-socials { display: flex; gap: .45rem; }
  .footer-socials a { display: grid; place-items: center; padding: .45rem; color: var(--color-bone-dim); }
  .footer-socials a:hover { color: var(--page-accent, var(--color-road)); }
  .footer-base { width: min(100% - 3rem, 70rem); margin: 2rem auto 0; padding-top: 1rem; border-top: 1px solid rgba(236,228,211,.12); color: #7f7669; font: .7rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 760px) { .footer-inner { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
